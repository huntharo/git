+#if defined(ATTR_CMNEXT_CLONE_REFCNT) && defined(EF_SHARES_ALL_BLOCKS)
+static int apfs_fully_shared(int fd, const struct stat *st)
+{
+	struct attrlist al = { 0 };
+	struct {
+		uint32_t len;
+		attribute_set_t returned;
+		dev_t device;
+		uint64_t inode;
+		off_t data_alloc;
+		uint32_t real_device;
+		uint64_t clone_id, flags;
+		uint32_t references;
+	} __attribute__((packed)) buf = { 0 };
+
+	al.bitmapcount = ATTR_BIT_MAP_COUNT;
+	al.commonattr = ATTR_CMN_RETURNED_ATTRS | ATTR_CMN_DEVID | ATTR_CMN_FILEID;
+	al.fileattr = ATTR_FILE_DATAALLOCSIZE;
+	al.forkattr = ATTR_CMNEXT_REALDEVID | ATTR_CMNEXT_CLONEID |
+		ATTR_CMNEXT_EXT_FLAGS | ATTR_CMNEXT_CLONE_REFCNT;
+	/*
+	 * No pathname or cached clone identity is involved: this descriptor pins
+	 * the vnode, including its physical volume and data-stream identity.
+	 * Still require every identity field and match the preceding fstat.
+	 * PACK_INVAL_ATTRS keeps offsets fixed when an attribute is unsupported;
+	 * the returned mask, not a zero-filled slot, establishes availability.
+	 */
+	if (fgetattrlist(fd, &al, &buf, sizeof(buf),
+			 FSOPT_ATTR_CMN_EXTENDED | FSOPT_PACK_INVAL_ATTRS) ||
+	    buf.len != sizeof(buf) ||
+	    (buf.returned.commonattr & al.commonattr) != al.commonattr ||
+	    (buf.returned.fileattr & al.fileattr) != al.fileattr ||
+	    (buf.returned.forkattr & al.forkattr) != al.forkattr)
+		return 0;
+	return buf.device == st->st_dev && buf.inode == st->st_ino &&
+		buf.real_device && buf.clone_id && buf.data_alloc >= 0 &&
+		on_disk_bytes(*st) >= 0 &&
+		(uintmax_t)buf.data_alloc <= (uintmax_t)on_disk_bytes(*st) &&
+		(buf.flags & EF_SHARES_ALL_BLOCKS) && buf.references >= 2;
+}
+#endif
